#pragma once
/* Copy to secrets.h and fill in. secrets.h is gitignored. */

/* Optional: leave these commented out to provision over the setup AP instead.
   Credentials stored in NVS always win over anything set here. */
/* #define WIFI_SSID "your-ssid" */
/* #define WIFI_PASS "your-password" */

/* Static IP strongly recommended — the router hands this address out as DNS,
   so it must not move. Comment the whole block out to use DHCP. */
#define STATIC_IP      "192.168.0.53"
#define STATIC_GATEWAY "192.168.0.1"
#define STATIC_NETMASK "255.255.255.0"

/* Upstream resolver. Must NOT be this device.
   AdGuard filters ads and trackers itself, so anything the local blocklist
   misses still gets caught. Mullvad: 194.242.2.4. Plain Cloudflare: 1.1.1.1. */
#define UPSTREAM_DNS "94.140.14.14"

/* Setup AP, used only when no credentials exist in NVS or below.
   Password must be 8+ chars, or the AP comes up open. */
#define SETUP_AP_SSID "esphole-setup"
#define SETUP_AP_PASS "esphole-setup"
