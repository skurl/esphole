#pragma once
/* Copy to secrets.h and fill in. secrets.h is gitignored. */

#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"

/* Static IP strongly recommended — the router hands this address out as DNS,
   so it must not move. Comment the whole block out to use DHCP. */
#define STATIC_IP      "192.168.0.53"
#define STATIC_GATEWAY "192.168.0.1"
#define STATIC_NETMASK "255.255.255.0"

/* Upstream resolver. Must NOT be this device. */
#define UPSTREAM_DNS "1.1.1.1"
